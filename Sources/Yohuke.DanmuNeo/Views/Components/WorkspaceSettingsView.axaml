<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:items="clr-namespace:Yohuke.DanmuNeo.ViewModels.Items"
             xmlns:state="clr-namespace:Yohuke.DanmuNeo.Models.State"
             x:Class="Yohuke.DanmuNeo.Views.Components.WorkspaceSettingsView"
             x:CompileBindings="False"
             x:Name="Root">
    <StackPanel Spacing="18"
                IsVisible="{Binding IsWorkspaceSettingsSelected}">
        <Border Classes="panel" Padding="14">
            <StackPanel Spacing="10">
                <TextBlock Text="工作区"
                           Classes="sectionTitle"/>
                <Grid ColumnDefinitions="*,Auto,Auto"
                      ColumnSpacing="8">
                    <TextBox Text="{Binding SelectedWorkspace.Name}"
                             Watermark="工作区名称"/>
	                    <Button Grid.Column="1"
	                            ToolTip.Tip="导出分享"
	                            Classes="iconButton"
	                            Click="ExportWorkspace_OnClick">
	                        <LucideIcon Kind="FileDown"/>
	                    </Button>
	                    <Button Grid.Column="2"
	                            ToolTip.Tip="删除工作区"
	                            Classes="iconButton"
	                            Command="{Binding OpenDeleteWorkspaceDialogCommand}"
	                            CommandParameter="{Binding SelectedWorkspace}">
	                        <LucideIcon Kind="Trash2"/>
	                    </Button>
                </Grid>
                <TextBlock Text="{Binding SelectedWorkspace.RoomCountText}"
                           Classes="muted"/>
            </StackPanel>
        </Border>

        <Border Classes="panel" Padding="14">
            <StackPanel Spacing="10">
                <TextBlock Text="账号覆盖"
                           Classes="sectionTitle"/>
                <TextBlock Text="{Binding SelectedWorkspace.AccountLabel}"
                           Classes="muted"/>
                <WrapPanel>
	                    <Button Margin="0,0,8,8"
	                            Command="{Binding ClearWorkspaceAccountCommand}">
	                        <StackPanel Orientation="Horizontal"
	                                    Spacing="6">
	                            <LucideIcon Kind="Globe"/>
	                            <TextBlock Text="使用全局账号"/>
	                        </StackPanel>
	                    </Button>
                    <ItemsControl ItemsSource="{Binding Accounts}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="state:BilibiliAccount">
                                <Button Content="{Binding Name}"
                                        Margin="0,0,8,8"
                                        Command="{Binding #Root.DataContext.SetWorkspaceAccountCommand}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Classes="panel" Padding="14">
            <StackPanel Spacing="10">
                <TextBlock Text="标签组"
                           Classes="sectionTitle"/>
                <TextBlock Text="当前工作区会记住这里选择的同传和歌词标签组。"
                           Classes="muted"/>
                <ComboBox ItemsSource="{Binding SymbolGroups}"
                          SelectedItem="{Binding SelectedWorkspaceMarkGroup}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="state:MarkSymbolGroup">
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </Border>

        <Border Classes="panel" Padding="14">
            <StackPanel Spacing="10">
                <TextBlock Text="直播间"
                           Classes="sectionTitle"/>
                <ItemsControl ItemsSource="{Binding SelectedWorkspace.Rooms}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="items:LiveRoomTabViewModel">
                            <Grid ColumnDefinitions="*,Auto,Auto"
                                  ColumnSpacing="8"
                                  Margin="0,4">
                                <TextBlock Text="{Binding RoomName}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding RoomId}"
                                           Classes="muted"/>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding ConnectionStatus}"
                                           Classes="muted"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
