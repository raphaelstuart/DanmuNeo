<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:workspace="clr-namespace:Yohuke.DanmuNeo.Models.Workspace"
             xmlns:state="clr-namespace:Yohuke.DanmuNeo.Models.State"
             xmlns:components="clr-namespace:Yohuke.DanmuNeo.Views.Components"
             xmlns:items="clr-namespace:Yohuke.DanmuNeo.ViewModels.Items"
             x:Class="Yohuke.DanmuNeo.Views.Components.LiveRoomWorkspaceView"
             x:CompileBindings="False"
             x:Name="Root">
    <Design.DataContext>
        <items:LiveRoomTabViewModel />
    </Design.DataContext>

    <Grid x:Name="WorkspaceColumns">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" MinWidth="420" />
            <ColumnDefinition Width="2" />
            <ColumnDefinition Width="*" MinWidth="300" />
        </Grid.ColumnDefinitions>

        <Border Classes="panel"
                Padding="14">
            <Grid RowDefinitions="Auto,*,Auto"
                  RowSpacing="12">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="8">
                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="8">
                        <Border Classes="listenStatusLight"
                                Classes.listening="{Binding IsListening}"
                                Classes.idle="{Binding IsNotListening}"
                                ToolTip.Tip="{Binding ConnectionStatus}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding RoomName}"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding RoomId}"
                                       Classes="muted" />
                        </StackPanel>
                    </Grid>
                    <Button Grid.Column="1"
                            Classes="listenToggleButton"
                            Classes.listening="{Binding IsListening}"
                            Classes.idle="{Binding IsNotListening}"
                            ToolTip.Tip="{Binding ConnectionStatus}"
                            Command="{Binding ToggleListeningCommand}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6">
                            <LucideIcon Kind="Radio"
                                        IsVisible="{Binding IsNotListening}" />
                            <LucideIcon Kind="CircleStop"
                                        IsVisible="{Binding IsListening}" />
                            <TextBlock Text="{Binding ListenToggleText}" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid Grid.Row="1"
                      RowDefinitions="Auto,*"
                      RowSpacing="10">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto,120,42"
                          ColumnSpacing="8"
                          VerticalAlignment="Center">
                        <ComboBox Height="30"
                                  VerticalAlignment="Center"
                                  VerticalContentAlignment="Center"
                                  ItemsSource="{Binding LiveQualityOptions}"
                                  SelectedItem="{Binding SelectedLiveQuality}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="workspace:LiveQualityOption">
                                    <TextBlock Text="{Binding Description}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Column="1"
                                ToolTip.Tip="{Binding LivePlayerToggleToolTip}"
                                Classes="iconButton"
                                Classes.selected="{Binding IsLivePlayerVisible}"
                                VerticalAlignment="Center"
                                Command="{Binding ToggleLivePlayerCommand}">
                            <Grid>
                                <LucideIcon Kind="CirclePlay"
                                            IsVisible="{Binding IsLivePlayerHidden}" />
                                <LucideIcon Kind="CircleStop"
                                            IsVisible="{Binding IsLivePlayerVisible}" />
                            </Grid>
                        </Button>
                        <Button Grid.Column="2"
                                ToolTip.Tip="追帧"
                                Classes="iconButton"
                                VerticalAlignment="Center"
                                Command="{Binding ChaseLiveCommand}">
                            <LucideIcon Kind="RefreshCw" />
                        </Button>
                        <Button Grid.Column="3"
                                ToolTip.Tip="静音"
                                Classes="iconButton"
                                Classes.selected="{Binding IsLivePlayerMuted}"
                                VerticalAlignment="Center"
                                Command="{Binding ToggleLivePlayerMutedCommand}">
                            <Grid>
                                <LucideIcon Kind="Volume2"
                                            IsVisible="{Binding IsLivePlayerAudible}" />
                                <LucideIcon Kind="VolumeX"
                                            IsVisible="{Binding IsLivePlayerMuted}" />
                            </Grid>
                        </Button>
                        <Slider Grid.Column="4"
                                Minimum="0"
                                Maximum="100"
                                Value="{Binding LivePlayerVolumePercent}"
                                VerticalAlignment="Center"
                                ToolTip.Tip="音量" />
                        <TextBlock Grid.Column="5"
                                   Text="{Binding LivePlayerVolumeText}"
                                   Classes="muted"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <Border x:Name="LivePlayerHost"
                                Classes="livePlayerSurface" />
                    </Grid>
                </Grid>

                <Border Grid.Row="2" Classes="translateComposer">
                    <Grid RowDefinitions="*,Auto"
                          RowSpacing="8">
                        <Grid>
                            <TextBox x:Name="InputDraftTextBox"
                                     Classes="translateComposerInput"
                                     Text="{Binding InputDraft}"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="False"
                                     KeyDown="InputDraft_OnKeyDown" />
                            <TextBlock Text="输入同传内容"
                                       Classes="muted"
                                       IsHitTestVisible="False"
                                       IsVisible="{Binding IsInputDraftEmpty}" />
                        </Grid>
                        <Grid Grid.Row="1"
                              ColumnDefinitions="*,Auto"
                              ColumnSpacing="10">
                            <ComboBox Classes="translateComposerMarkSelector"
                                      ItemsSource="{Binding DataContext.SymbolGroups, RelativeSource={RelativeSource AncestorType=Window}}"
                                      SelectedItem="{Binding DataContext.SelectedWorkspaceMarkGroup, RelativeSource={RelativeSource AncestorType=Window}}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="state:MarkSymbolGroup">
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="1"
                                    Classes="translateComposerSendButton"
                                    ToolTip.Tip="发送同传"
                                    Command="{Binding SendDraftCommand}">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="6">
                                    <LucideIcon Kind="Send" />
                                    <TextBlock Text="发送" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1"
                      Width="2"
                      Classes="workspaceSplitter"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext"
                      PointerReleased="WorkspaceSplitter_OnPointerReleased" />

        <Grid Grid.Column="2">
            <Border Classes="panel"
                    Padding="14">
                <TabControl Classes="workspaceToolTabs">
                    <TabItem Header="弹幕">
                        <Grid RowDefinitions="*"
                              RowSpacing="10"
                              Margin="0,10,0,0">
                            <ScrollViewer x:Name="DanmuScrollViewer"
                                          Grid.Row="0">
                                <ItemsControl x:Name="DanmuItemsControl"
                                              ItemsSource="{Binding DanmuItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="workspace:DanmuFeedItem">
                                            <Button Classes="danmuFeedButton"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch"
                                                    ContextRequested="Danmu_OnContextRequested"
                                                    Click="Danmu_OnClick">
                                                <Grid ColumnDefinitions="96,*"
                                                      ColumnSpacing="10">
                                                    <StackPanel Spacing="1">
                                                        <TextBlock Text="{Binding UserName}"
                                                                   Classes="danmuFeedUser"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding DetailLine}"
                                                                   Classes="danmuFeedMeta"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Content}"
                                                               Classes="danmuFeedContent"
                                                               TextWrapping="Wrap" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <TabItem Header="SC">
                        <Grid RowDefinitions="*"
                              RowSpacing="10"
                              Margin="0,10,0,0">
                            <ListBox Grid.Row="0"
                                     Classes="feedList"
                                     ItemsSource="{Binding SuperChats}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="workspace:SuperChatItem">
                                        <Button Classes="scFeedButton"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Click="SuperChat_OnClick">
                                            <Grid ColumnDefinitions="96,*"
                                                  ColumnSpacing="10">
                                                <StackPanel Spacing="1">
                                                    <TextBlock Text="{Binding UserName}"
                                                               Classes="danmuFeedUser"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding DetailLine}"
                                                               Classes="danmuFeedMeta"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Content}"
                                                           Classes="danmuFeedContent"
                                                           TextWrapping="Wrap" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </TabItem>

                    <TabItem Header="历史">
                        <Grid RowDefinitions="Auto,*"
                              RowSpacing="10"
                              Margin="0,10,0,0">
                            <Grid ColumnDefinitions="*,Auto,Auto"
                                  ColumnSpacing="8">
                                <TextBlock Text="同传历史"
                                           Classes="sectionTitle"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="1"
                                        ToolTip.Tip="导出 Excel"
                                        Classes="iconButton"
                                        IsEnabled="{Binding HasTranslateHistory}"
                                        Click="ExportTranslateHistory_OnClick">
                                    <LucideIcon Kind="Download" />
                                </Button>
                                <Button Grid.Column="2"
                                        ToolTip.Tip="清空历史"
                                        Classes="iconButton"
                                        IsEnabled="{Binding HasTranslateHistory}"
                                        Command="{Binding ClearTranslateHistoryCommand}">
                                    <LucideIcon Kind="Trash2" />
                                </Button>
                            </Grid>
                            <ScrollViewer Grid.Row="1">
                                <ItemsControl ItemsSource="{Binding TranslateHistoryItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="workspace:DanmuFeedItem">
                                            <Border Classes="historyRecordCard">
                                                <Grid RowDefinitions="Auto,Auto"
                                                      RowSpacing="4">
                                                    <Grid ColumnDefinitions="*,Auto"
                                                          ColumnSpacing="8">
                                                        <TextBlock Text="{Binding DisplayTime}"
                                                                   Classes="danmuFeedMeta" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Status}"
                                                                   Classes="danmuFeedMeta"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                    <TextBlock Grid.Row="1"
                                                               Text="{Binding Content}"
                                                               Classes="danmuFeedContent"
                                                               TextWrapping="Wrap" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <TabItem Header="歌词">
                        <Grid RowDefinitions="Auto,Auto,*"
                              RowSpacing="8"
                              Margin="0,10,0,0">
                            <Grid ColumnDefinitions="*,Auto,Auto"
                                  ColumnSpacing="8">
                                <TextBlock Text="{Binding CurrentLyricTitleText}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           FontWeight="SemiBold" />
                                <Button Grid.Column="1"
                                        ToolTip.Tip="打开歌词库"
                                        Classes="iconButton"
                                        Command="{Binding #Root.OpenLyricLibraryPickerCommand}">
                                    <LucideIcon Kind="Library" />
                                </Button>
                                <Button Grid.Column="2"
                                        ToolTip.Tip="清空歌词"
                                        Classes="iconButton"
                                        Command="{Binding ClearLyricCommand}">
                                    <LucideIcon Kind="Trash2" />
                                </Button>
                            </Grid>

                            <Grid Grid.Row="1"
                                  ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                                  ColumnSpacing="8">
                                <Grid Grid.Column="0"
                                      ColumnDefinitions="Auto,56,Auto"
                                      ColumnSpacing="4"
                                      VerticalAlignment="Center">
                                    <TextBlock Text="速率"
                                               Classes="muted"
                                               VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1"
                                             Classes="lyricRateInput"
                                             Text="{Binding LyricPlaybackRate, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                    <TextBlock Grid.Column="2"
                                               Text="x"
                                               Classes="muted"
                                               VerticalAlignment="Center" />
                                </Grid>
                                <Button Grid.Column="1"
                                        ToolTip.Tip="快退 0.5 秒"
                                        Classes="iconButton"
                                        Command="{Binding RewindLyricCommand}">
                                    <LucideIcon Kind="CircleArrowLeft" />
                                </Button>
                                <Button Grid.Column="2"
                                        ToolTip.Tip="快进 0.5 秒"
                                        Classes="iconButton"
                                        Command="{Binding FastForwardLyricCommand}">
                                    <LucideIcon Kind="CircleArrowRight" />
                                </Button>
                                <Button Grid.Column="4"
                                        ToolTip.Tip="自动/暂停"
                                        Classes="iconButton"
                                        Command="{Binding ToggleAutoLyricCommand}">
                                    <LucideIcon Kind="CirclePlay" />
                                </Button>
                                <Button Grid.Column="5"
                                        ToolTip.Tip="停止歌词发送"
                                        Classes="iconButton"
                                        Command="{Binding StopAutoLyricCommand}">
                                    <LucideIcon Kind="CircleStop" />
                                </Button>
                                <CheckBox Grid.Column="3"
                                          IsChecked="{Binding PreventRepeatedLyricSend}"
                                          ToolTip.Tip="退回已发送歌词时不重复发送"
                                          VerticalAlignment="Center" />
                            </Grid>
                            <ListBox x:Name="LyricListBox"
                                     Grid.Row="2"
                                     Classes="lyricLineList"
                                     ItemsSource="{Binding Lyrics}"
                                     SelectedItem="{Binding ActiveLyricLine}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="workspace:LyricLineState">
                                        <Border Classes="lyricLine"
                                                Classes.active="{Binding IsActive}"
                                                Classes.sent="{Binding IsSent}"
                                                DoubleTapped="LyricLine_OnDoubleTapped">
                                            <Grid>
                                                <ProgressBar Classes="lyricLineProgress"
                                                             Minimum="0"
                                                             Maximum="1"
                                                             Value="{Binding Progress}"
                                                             IsHitTestVisible="False" />
                                                <Grid ColumnDefinitions="56,*"
                                                      Margin="0,1">
                                                    <TextBlock Text="{Binding Timeline}"
                                                               Classes="muted"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Content}"
                                                               TextWrapping="Wrap"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </TabItem>

                    <TabItem Header="转发">
                        <Grid RowDefinitions="Auto,*"
                              RowSpacing="10"
                              Margin="0,10,0,0">
                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="8">
                                <StackPanel>
                                    <TextBlock Text="监听其它直播间并转发匹配弹幕"
                                               Classes="sectionTitle" />
                                    <TextBlock Text="UID 和正则至少填写一个；都填写时需同时满足。命中后会自动套用开闭规则。"
                                               Classes="muted" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Classes="iconButton"
                                        ToolTip.Tip="添加转发规则"
                                        Command="{Binding AddForwardRuleCommand}">
                                    <LucideIcon Kind="Plus" />
                                </Button>
                            </Grid>
                            <ScrollViewer Grid.Row="1">
                                <ItemsControl ItemsSource="{Binding ForwardRules}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Classes="forwardRuleCard">
                                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                                                      RowSpacing="8">
                                                    <Grid ColumnDefinitions="Auto,*,Auto"
                                                          ColumnSpacing="8">
                                                        <CheckBox IsChecked="{Binding IsEnabled}"
                                                                  VerticalAlignment="Center" />
                                                        <ComboBox Grid.Column="1"
                                                                  HorizontalAlignment="Stretch"
                                                                  ItemsSource="{Binding DataContext.ForwardSourceRooms, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                  SelectedValue="{Binding SourceRoomKey}"
                                                                  SelectedValueBinding="{Binding Key}">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate
                                                                    DataType="workspace:ForwardSourceRoomOption">
                                                                    <TextBlock Text="{Binding DisplayName}"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                        <Button Grid.Column="2"
                                                                Classes="iconButton"
                                                                ToolTip.Tip="删除规则"
                                                                Command="{Binding DataContext.RemoveForwardRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}">
                                                            <LucideIcon Kind="Trash2" />
                                                        </Button>
                                                    </Grid>
                                                    <Grid Grid.Row="1"
                                                          ColumnDefinitions="*">
                                                        <TextBox Watermark="发送人 UID"
                                                                 Text="{Binding SenderUid}" />
                                                    </Grid>
                                                    <Grid Grid.Row="2"
                                                          ColumnDefinitions="*">
                                                        <TextBox
                                                            Watermark="同传格式正则，例如 ^【.*】$"
                                                            Text="{Binding ContentPattern}" />
                                                    </Grid>
                                                    <Grid Grid.Row="3"
                                                          ColumnDefinitions="*">
                                                        <ComboBox
                                                            HorizontalAlignment="Stretch"
                                                            ToolTip.Tip="转发发送账号"
                                                            ItemsSource="{Binding DataContext.ForwardAccountOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            SelectedValue="{Binding AccountOverrideId}"
                                                            SelectedValueBinding="{Binding AccountId}">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate DataType="items:ForwardAccountOption">
                                                                    <TextBlock Text="{Binding DisplayName}"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                    </Grid>
                                                    <Grid Grid.Row="4"
                                                          ColumnDefinitions="*">
                                                        <ComboBox
                                                            HorizontalAlignment="Stretch"
                                                            ToolTip.Tip="转发开闭规则"
                                                            ItemsSource="{Binding DataContext.SymbolGroups, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            SelectedValue="{Binding MarkSymbolGroupId}"
                                                            SelectedValueBinding="{Binding Id}">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate DataType="state:MarkSymbolGroup">
                                                                    <TextBlock Text="{Binding Name}"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                    </Grid>
                                                    <TextBlock Grid.Row="5"
                                                               Text="{Binding StatusText}"
                                                               Classes="muted" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>

            <Border Classes="lyricPickerOverlay"
                    IsVisible="{Binding DataContext.IsLyricLibraryPickerOpen, RelativeSource={RelativeSource AncestorType=Window}}"
                    DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                <Border Classes="lyricPickerPanel">
                    <Grid RowDefinitions="Auto,*"
                          RowSpacing="12">
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="8">
                            <StackPanel>
                                <TextBlock Text="歌词库"
                                           Classes="sectionTitle" />
                                <TextBlock Text="选择后会加载到当前直播间"
                                           Classes="muted" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Classes="iconButton"
                                    ToolTip.Tip="关闭"
                                    Command="{Binding #Root.CloseLyricLibraryPickerCommand}">
                                <LucideIcon Kind="X" />
                            </Button>
                        </Grid>
                        <ScrollViewer Grid.Row="1">
                            <StackPanel Spacing="14">
                                <components:LyricOnlineImportView LoadToCurrentRoom="True" />
                                <Border BorderBrush="{DynamicResource AppBorderBrush}"
                                        BorderThickness="0,1,0,0"
                                        Padding="0,12,0,0">
                                    <components:LyricLibraryListView />
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Border>
        </Grid>
    </Grid>
</UserControl>
