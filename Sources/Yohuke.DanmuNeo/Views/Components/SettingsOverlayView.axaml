<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:items="clr-namespace:Yohuke.DanmuNeo.ViewModels.Items"
             xmlns:components="clr-namespace:Yohuke.DanmuNeo.Views.Components"
             x:Class="Yohuke.DanmuNeo.Views.Components.SettingsOverlayView"
             x:CompileBindings="False"
             x:Name="Root">
    <Border Classes="settingsOverlay"
            IsVisible="{Binding IsSettingsOpen}">
        <Border Margin="16,10,16,16"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Classes="settingsPanel">
            <Grid RowDefinitions="Auto,Auto,*,Auto"
                  RowSpacing="16">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="设置"
                               FontSize="20"
                               FontWeight="SemiBold"/>
	                    <Button Grid.Column="1"
	                            Classes="iconButton"
	                            Command="{Binding CloseSettingsCommand}">
	                        <LucideIcon Kind="X"/>
	                    </Button>
                </Grid>

                <ItemsControl Grid.Row="1"
                              ItemsSource="{Binding SettingsSectionOptions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="items:SettingsSectionOption">
                            <Button Classes="settingsSectionButton"
                                    Classes.selected="{Binding IsSelected}"
                                    Command="{Binding #Root.DataContext.SelectSettingsSectionCommand}"
                                    CommandParameter="{Binding}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Description}"
                                               Classes="muted"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <components:SettingsConfigContainerView Grid.Row="2"/>

                <StackPanel Grid.Row="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="8">
	                    <Button Classes="primaryButton"
	                            Command="{Binding CloseSettingsCommand}">
	                        <StackPanel Orientation="Horizontal"
	                                    Spacing="6">
	                            <LucideIcon Kind="Save"/>
	                            <TextBlock Text="保存"/>
	                        </StackPanel>
	                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Border>
</UserControl>
