<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:items="clr-namespace:Yohuke.DanmuNeo.ViewModels.Items"
             xmlns:components="clr-namespace:Yohuke.DanmuNeo.Views.Components"
             x:Class="Yohuke.DanmuNeo.Views.Components.WorkspaceTabsView"
             x:CompileBindings="False"
             x:Name="Root">
    <ContentControl Content="{Binding SelectedWorkspace.SelectedRoom}">
        <ContentControl.ContentTemplate>
            <DataTemplate DataType="items:LiveRoomTabViewModel">
                <components:LiveRoomWorkspaceView/>
            </DataTemplate>
        </ContentControl.ContentTemplate>
    </ContentControl>
</UserControl>
