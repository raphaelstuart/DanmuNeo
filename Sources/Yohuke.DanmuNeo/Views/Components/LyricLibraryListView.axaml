<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:state="clr-namespace:Yohuke.DanmuNeo.Models.State"
             x:Class="Yohuke.DanmuNeo.Views.Components.LyricLibraryListView"
             x:CompileBindings="False"
             x:Name="Root">
    <StackPanel Spacing="10">
        <TextBox Watermark="搜索歌名、歌手、标签或来源"
                 Text="{Binding LyricLibrarySearchText}"/>
        <ItemsControl ItemsSource="{Binding FilteredLyricLibrary}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="state:LyricLibraryItem">
                    <Border BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="0,8">
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                              ColumnSpacing="8">
                            <StackPanel>
                                <TextBlock Text="{Binding DisplayTitle}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding SourceLabel}"
                                           Classes="muted"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    ToolTip.Tip="使用"
                                    Classes="iconButton"
                                    Command="{Binding #Root.PickLyricLibraryItemCommand}"
                                    CommandParameter="{Binding}">
                                <LucideIcon Kind="BookOpen"/>
                            </Button>
                            <Button Grid.Column="2"
                                    ToolTip.Tip="修改"
                                    Classes="iconButton"
                                    IsVisible="{Binding #Root.ShowEditButton}"
                                    Click="EditLyric_OnClick">
                                <LucideIcon Kind="Pencil"/>
                            </Button>
                            <Button Grid.Column="3"
                                    ToolTip.Tip="删除"
                                    Classes="iconButton"
                                    Command="{Binding #Root.DeleteLyricLibraryItemCommand}"
                                    CommandParameter="{Binding}">
                                <LucideIcon Kind="Trash2"/>
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
